{
  "name": "spring-nav",
  "displayName": "SpringNav",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "hei-world",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei-World/SpringNav.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "spring",
    "springboot",
    "java",
    "mybatis",
    "navigation",
    "definition"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts"
  ],
  "contributes": {
    "commands": [
      {
        "command": "springNav.searchByPath",
        "title": "%command.searchByPath%"
      },
      {
        "command": "springNav.reindex",
        "title": "%command.reindex%"
      },
      {
        "command": "springNav.reindexFolder",
        "title": "%command.reindexFolder%"
      },
      {
        "command": "springNav.goToImplementation",
        "title": "%command.goToDefinition%"
      },
      {
        "command": "springNav.goToReference",
        "title": "%command.goToReference%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "springNav.reindexFolder",
          "when": "explorerResourceIsFolder && resourcePath in springNav.projectFolders",
          "group": "springnav@1"
        }
      ],
      "commandPalette": [
        {
          "command": "springNav.reindexFolder",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "springNav.goToReference",
          "when": "editorLangId == 'java' || editorLangId == 'xml'",
          "group": "navigation@1"
        },
        {
          "command": "springNav.goToImplementation",
          "when": "editorLangId == 'java' || editorLangId == 'xml'",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "springNav.goToReference",
        "key": "f12",
        "when": "editorTextFocus && (editorLangId == 'java' || editorLangId == 'xml')"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "springNav.defaultDirection": {
          "type": "string",
          "enum": [
            "down",
            "up",
            "both"
          ],
          "default": "down",
          "description": "%config.defaultDirection.description%"
        },
        "springNav.fallbackOnEmpty": {
          "type": "boolean",
          "default": true,
          "description": "%config.fallbackOnEmpty.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:native",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:native": "bash scripts/build-native.sh",
    "build": "npm run compile && npm run build:native",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "test:native": "node scripts/smoke.js",
    "test:harness": "node test/harness.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.6.3"
  },
  "napi": {
    "binaryName": "spring-nav",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  }
}