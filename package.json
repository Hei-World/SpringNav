{
  "name": "spring-nav",
  "displayName": "SpringNav",
  "description": "Lightweight SpringBoot code navigation for VS Code, powered by a Rust/napi-rs native index.",
  "version": "0.1.0",
  "publisher": "hei-world",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei-World/SpringNav.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "spring",
    "springboot",
    "java",
    "mybatis",
    "navigation",
    "definition"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts"
  ],
  "contributes": {
    "commands": [
      {
        "command": "springNav.searchByPath",
        "title": "SpringNav: Search by URL path"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:native",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:native": "bash scripts/build-native.sh",
    "build": "npm run compile && npm run build:native",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "test:native": "node scripts/smoke.js",
    "test:harness": "node test/harness.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.6.3"
  },
  "napi": {
    "binaryName": "spring-nav",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  }
}
