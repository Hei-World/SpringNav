{
  "name": "spring-nav",
  "displayName": "SpringNav",
  "description": "Lightweight SpringBoot code navigation for VS Code, powered by a Rust/napi-rs native index.",
  "version": "0.1.0",
  "publisher": "hei-world",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei-World/SpringNav.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "spring",
    "springboot",
    "java",
    "mybatis",
    "navigation",
    "definition"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts"
  ],
  "contributes": {
    "commands": [
      {
        "command": "springNav.searchByPath",
        "title": "SpringNav: Search by URL path"
      },
      {
        "command": "springNav.goToImplementation",
        "title": "转到Java实现"
      },
      {
        "command": "springNav.goToReference",
        "title": "转到Java引用"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "springNav.goToImplementation",
          "when": "editorLangId == 'java' || editorLangId == 'xml'",
          "group": "navigation@1"
        },
        {
          "command": "springNav.goToReference",
          "when": "editorLangId == 'java' || editorLangId == 'xml'",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "springNav.goToReference",
        "key": "f12",
        "when": "editorTextFocus && (editorLangId == 'java' || editorLangId == 'xml')"
      }
    ],
    "configuration": {
      "title": "SpringNav",
      "properties": {
        "springNav.defaultDirection": {
          "type": "string",
          "enum": [
            "down",
            "up",
            "both"
          ],
          "default": "down",
          "description": "Ctrl/Cmd+点击（Go to Definition）的默认方向。down = 控制器→接口→实现→Mapper→XML，getXX→字段；up = 逐级反向；both = 两个方向都返回。"
        },
        "springNav.fallbackOnEmpty": {
          "type": "boolean",
          "default": true,
          "description": "指定方向没有匹配结果时，是否自动回退到相反方向一级。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:native",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:native": "bash scripts/build-native.sh",
    "build": "npm run compile && npm run build:native",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "test:native": "node scripts/smoke.js",
    "test:harness": "node test/harness.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.6.3"
  },
  "napi": {
    "binaryName": "spring-nav",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  }
}
